# Copy this file to .env and fill in ONE of these (chat.py/app_streamlit.py
# auto-detect which one is set). Neither is required - omit both to fall
# back to a free local model (see README: --backend local).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force a specific backend instead of auto-detecting.
# One of: anthropic, openai, local, echo
# RAG_GENERATOR_BACKEND=
